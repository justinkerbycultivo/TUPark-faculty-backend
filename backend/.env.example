MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/tupark?appName=TUPark
PORT=5000

# Password reset email (SMTP). Leave blank to disable email sending.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TUPark <no-reply@example.com>
# Local development only: print reset codes to the server console. Never on production.
RESET_DEV_LOG=false

# JWT authentication
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
